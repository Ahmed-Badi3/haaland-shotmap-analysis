   "source": [
    "# df.shape[0] récupère le nombre total de lignes du tableau. Comme chaque ligne correspond à un tir, cela donne le nombre total de tirs.\n",
    "total_shots = df.shape[0]\n",
    "print(total_shots)\n",
    "\n",
    "# On filtre le tableau pour ne garder que les lignes où le résultat est un but ('Goal'), puis on compte combien il y a de lignes correspondantes pour obtenir le nombre total de buts marqués.\n",
    "total_goals = df[df['result'] == 'Goal'].shape[0]\n",
    "print(total_goals)\n",
    "\n",
    "# On additionne toutes les valeurs de la colonne xG (Expected Goals) pour connaître le total des xG accumulés.\n",
    "total_xG = df['xG'].sum()\n",
    "print(total_xG)\n",
    "\n",
    "# On calcule la dangerosité moyenne d'un tir en divisant le total des xG par le nombre total de tirs (l'xG moyen par tir).\n",
    "xG_per_shot = total_xG / total_shots\n",
    "print(xG_per_shot)\n",
    "\n",
    "# On calcule la moyenne mathématique de la colonne X (qui a été multipliée par 100 juste avant).\n",
    "points_average_distance = df['X'].mean()\n",
    "points_average_distance\n",
    "\n",
    "# C'est une formule de conversion pour estimer la distance moyenne réelle en mètres par rapport à la ligne de but (en se basant sur un terrain étalonné sur 120 de long).\n",
    "actual_average_distance = 120 - ((df['X'] / 100) * 1.2).mean()\n",
    "print(\"Actual average distance :\", actual_average_distance)"
